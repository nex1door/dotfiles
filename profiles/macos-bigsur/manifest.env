# Профиль оформления: macOS Big Sur (WhiteSur)
# Читается из theme-switch.sh (source). PLANK_* — только для дока plank.
PROFILE_TITLE="macOS Big Sur (WhiteSur)"
PROFILE_DESC="Тёмная macOS-тема: WhiteSur, Apple-меню, док снизу, обои Ventura"

# Точные значения xfconf — в xfconf.tsv; здесь дубли для справки/списка профилей
GTK_THEME=WhiteSur-Dark
XFWM_THEME=WhiteSur-Dark
ICON_THEME=WhiteSur-dark
CURSOR_THEME=WhiteSur-cursors

# Шрифт применится только если реально установлен (fc-list), иначе пропуск.
# Inter — открытая замена SF Pro; ставится scripts/install-assets.sh
FONT_NAME="Inter 11"

WALLPAPER="$HOME/Изображения/Обои/macos/ventura.jpg"

# Эффекты композитора: скругления 12px, крупные мягкие тени, dual-kawase размытие.
# Конфиг: ~/dotfiles/config/picom/picom.conf (для форков с анимациями — picom-animations.conf).
# Выключить/включить: Win+P или scripts/picom-toggle.sh
PICOM_ENABLE=1

# Плагины панели, которым нужен свой каталог launcher-<id>/
# формат: <id плагина>:<путь к .desktop>
LAUNCHERS=(
  "7:$HOME/.local/share/applications/theme-switch.desktop"
  "10:/usr/share/applications/thunar.desktop"
  "11:/usr/share/applications/firefox.desktop"
  "12:/usr/share/applications/xfce4-terminal.desktop"
  "13:/usr/share/applications/org.telegram.desktop.desktop"
  "14:/usr/share/applications/vlc.desktop"
)

# ── plank (установить: sudo pacman -S plank) ───────────────────────────────────
PLANK_THEME="mcOS-BS-iMacM1-Black"
PLANK_POSITION="bottom"
PLANK_ICON_SIZE=44
PLANK_HIDE_MODE="intelligent"
PLANK_ITEMS="/usr/share/applications/thunar.desktop /usr/share/applications/firefox.desktop /usr/share/applications/xfce4-terminal.desktop /usr/share/applications/org.telegram.desktop.desktop /usr/share/applications/vlc.desktop"